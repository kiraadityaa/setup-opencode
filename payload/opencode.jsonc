{
  // OpenCode Ultimate Config — generated by setup-opencode
  // https://github.com/kiraadityaa/setup-opencode
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "share": "manual",
  "logLevel": "WARN",
  "snapshot": true,
  "lsp": true,
  "formatter": true,

  // Free models (no auth required). After `opencode auth login`,
  // run /models and update these to your preferred models.
  "model": "opencode/big-pickle",
  "small_model": "opencode/mimo-v2.5-free",

  "instructions": ["instructions/shell-strategy.md"],

  "experimental": {
    "primary_tools": ["edit"],
    "mcp_timeout": 30000
  },

  // Permission: LAST matching rule wins.
  // Broad rules first, specific rules last.
  "permission": {
    "edit": "allow",
    "read": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "task": "allow",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "git push*": "ask",
      "git push --force*": "deny",
      "curl *": "allow",
      "npm view*": "allow",
      "npm ping*": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "node -v*": "allow",
      "python3 --version*": "allow",
      "npm publish*": "deny",
      "docker push*": "deny",
      "gem publish*": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny"
    },
    "external_directory": {
      "*": "allow"
    }
  },

  // MCP servers — all free
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "agent-browser": {
      "type": "local",
      "command": ["agent-browser", "mcp", "--tools", "core"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "__HOME__/work", "/tmp"],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    }
  },

  // Plugins — all free
  "plugin": [
    "opencode-gemini-auth@latest",
    "@tarquinen/opencode-dcp@latest",
    "opencode-vibeguard@latest",
    "./plugins/opencode-notificator/notificator.js"
  ],

  // Skills: local custom + external repos (cloned during setup)
  "skills": {
    "paths": [
      "./skills",
      "./_deps/anthropic-skills",
      "./_deps/agent-browser-skills",
      "./_deps/agent-browser-skilldata"
    ]
  }
}